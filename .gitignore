kernel_meta/
kernel_meta_*/
.cache/
.triton/
.triton_cache/
torch_compile_debug/

# Native build intermediates / 本地编译中间文件
build/
dist/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
.ninja_deps
.ninja_log
build.ninja
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.pdb
*.ilk

# Python bytecode, packaging and tool caches / Python 缓存及打包产物
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
