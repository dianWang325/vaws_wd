# Linux-first repository: keep all detected text Unix-compatible.
* text=auto eol=lf

# Linux execution and source files must never be checked out with CRLF.
*.sh text eol=lf
*.py text eol=lf

# Preserve native line endings for Windows command scripts.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never apply text conversion to common binary artifacts.
*.7z binary
*.bin binary
*.gif binary
*.gz binary
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.safetensors binary
*.tar binary
*.tgz binary
*.webp binary
*.zip binary
